[Unit]
Description=Booking Flask Admin
After=network.target

[Service]
User=bookingbot
Group=bookingbot
WorkingDirectory=/opt/booking_bot
EnvironmentFile=/opt/booking_bot/.env
ExecStart=/opt/booking_bot/venv/bin/python /opt/booking_bot/admin_panel.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
